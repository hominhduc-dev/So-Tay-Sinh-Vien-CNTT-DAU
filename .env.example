# Chép thành .env rồi đổi giá trị. Không commit tệp .env.
DB_PASSWORD=doi-mat-khau-csdl
# Chuỗi ngẫu nhiên ≥ 32 ký tự, ví dụ: openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Origin được phép gọi API trực tiếp. Web client đi qua proxy /api nên để * là đủ.
CORS_ORIGINS=*
# Bỏ ",classpath:db/demo" khi triển khai thật để không tạo tài khoản demo
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
