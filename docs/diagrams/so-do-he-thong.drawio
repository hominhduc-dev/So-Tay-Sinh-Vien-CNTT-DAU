        </mxCell>
        <mxCell id="precondition" value="ref · Mỗi yêu cầu là một khung JSON {id, action, token, data} trên kết nối TCP đang mở. SocketDispatcher: JWT → đọc users → kiểm trạng thái / đơn vị / vai. Lỗi xác thực: UNAUTHORIZED; thiếu vai: FORBIDDEN." style="text;align=left;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="25" y="55" width="1119" height="40" as="geometry" />
        </mxCell>
        <mxCell id="participant-user" value="Người dùng" style="rounded=0;strokeColor=#64748b;fillColor=#eff6ff;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="21" y="110" width="158" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lifeline-user" style="dashed=1;endArrow=none;strokeColor=#94a3b8;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="150" as="sourcePoint" />
            <mxPoint x="100" y="425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="participant-web" value="Client Java Swing" style="rounded=0;strokeColor=#64748b;fillColor=#f8fafc;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="344" y="110" width="158" height="40" as="geometry" />
