        <mxCell id="frame-title" value="Cấu trúc một khung (giống hệt hai phía, lớp FrameCodec)" style="text;align=left;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="680" height="28" as="geometry" />
        </mxCell>
        <mxCell id="frame-len" value="&lt;b&gt;4 byte&lt;/b&gt;&lt;br&gt;độ dài N&lt;br&gt;(int, big-endian)" style="rounded=0;fillColor=#e0f2fe;strokeColor=#0369a1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="635" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="frame-body" value="&lt;b&gt;N byte&lt;/b&gt; — JSON mã hóa UTF-8 (N ≤ 32 MB)" style="rounded=0;fillColor=#f0f9ff;strokeColor=#0369a1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="200" y="635" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="frame-ex" value="&lt;b&gt;Ví dụ&lt;/b&gt;&lt;br&gt;client → server: {&quot;id&quot;: 3, &quot;action&quot;: &quot;chat.ask&quot;, &quot;token&quot;: &quot;eyJ…&quot;, &quot;data&quot;: {&quot;questionId&quot;: &quot;…&quot;}}&lt;br&gt;server → client: {&quot;id&quot;: 3, &quot;ok&quot;: true, &quot;data&quot;: {&quot;conversationId&quot;: &quot;…&quot;, &quot;message&quot;: {…}}}&lt;br&gt;server → client: {&quot;id&quot;: 4, &quot;ok&quot;: false, &quot;error&quot;: {&quot;code&quot;: &quot;FORBIDDEN&quot;, &quot;message&quot;: &quot;Không đủ quyền.&quot;}}&lt;br&gt;&lt;br&gt;&lt;b&gt;25 action&lt;/b&gt;: system.ping · auth.* · chat.ask · conversation.* · topic.* · question.* · document.* · user.* · system.health&lt;br&gt;Tệp tải lên / tải về đi trong JSON dạng base64 (≤ 20 MB)." style="text;align=left;verticalAlign=top;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="680" height="200" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="Không dùng HTTP, REST hay WebSocket: client và server tự đọc / ghi luồng byte TCP. Server phục vụ nhiều client đồng thời (thread-per-connection); mỗi yêu cầu nhận đúng một phản hồi theo thứ tự. Quyền luôn kiểm ở server — client ẩn tab theo vai chỉ để gọn giao diện." style="text;align=left;verticalAlign=top;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1520" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
