        <mxCell id="label-27" value="12. readInt gặp EOF → đóng socket, trả luồng" style="text;fillColor=#ffffff;align=left;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="594.5" y="725" width="300" height="31" as="geometry" />
        </mxCell>
        <mxCell id="message-28" style="endArrow=block;endFill=1;strokeColor=#334155;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="584.5" y="756" as="sourcePoint" />
            <mxPoint x="584.5" y="767" as="targetPoint" />
            <Array as="points">
              <mxPoint x="634.5" y="756" />
              <mxPoint x="634.5" y="767" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="notes" value="Khung &gt; 32 MB: FRAME_TOO_LARGE rồi đóng kết nối. Im lặng quá 30 phút: SocketTimeoutException, server đóng. JSON hỏng / action lạ: BAD_FRAME / UNKNOWN_ACTION, kết nối vẫn mở.&lt;br&gt;Client mất kết nối: SocketClient báo NETWORK_ERROR, lần gọi sau tự connect lại. Nhiều client: mỗi kết nối một ClientConnection chạy song song (pool 64 luồng).&lt;br&gt;Nét liền: gửi; nét đứt: trả về." style="text;align=left;verticalAlign=top;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="25" y="809" width="1119" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
