        <mxCell id="notes" value="Nhánh DB DOWN chỉ xảy ra nếu request đã qua xác thực. DB hỏng ở JwtAuthFilter có thể chặn trước controller.&lt;br&gt;Đường dẫn HTTP lược tiền tố /api. Nét liền: gọi / gửi; nét đứt: trả về (có thể lược bỏ). API gom controller + service." style="text;align=left;verticalAlign=top;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="25" y="725" width="1119" height="76" as="geometry" />
