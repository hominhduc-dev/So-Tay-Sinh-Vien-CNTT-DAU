              <mxPoint x="770" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-5" value="EOF (client close) / đóng socket" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-idle" target="st-end">
          <mxGeometry relative="1" as="geometry">
