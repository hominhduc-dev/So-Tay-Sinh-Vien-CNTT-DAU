        </mxCell>
        <mxCell id="legend" parent="1" style="text;align=left;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" value="&lt;b&gt;3 Core Cardinalities:&lt;/b&gt; 1:1 = một–một; 1:N = một–nhiều; M:N = nhiều–nhiều.&lt;br&gt;Schema hiện tại có 6 quan hệ 1:N; chưa có quan hệ 1:1 hoặc M:N trực tiếp.&lt;br&gt;N biểu thị phía nhiều (có thể 0 bản ghi con); mỗi bản ghi con thuộc đúng 1 bản ghi cha.&lt;br&gt;PK = khóa chính; FK = khóa ngoại; UQ = duy nhất; NULL = cho phép rỗng. Chỉ documents.page_count cho phép NULL." vertex="1">
          <mxGeometry height="100" width="1530" x="70" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="text;align=left;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" value="&lt;b&gt;Ràng buộc:&lt;/b&gt; questions.page ≥ 1; role ∈ {USER, CONTENT_ADMIN, SYSTEM_ADMIN}.&lt;br&gt;&lt;b&gt;ON DELETE CASCADE:&lt;/b&gt; users → conversations → messages. Các quan hệ còn lại RESTRICT.&lt;br&gt;messages chỉ lưu tham chiếu câu hỏi; không lưu bản chụp câu trả lời. Nội dung trả lời nằm ở questions.answer." vertex="1">
          <mxGeometry height="100" width="1530" x="70" y="1180" as="geometry" />
        </mxCell>
