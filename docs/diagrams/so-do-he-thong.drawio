      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Sơ đồ trạng thái — Phiên làm việc phía client (SocketClient + MainFrame)" style="text;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="st-s" value="" style="ellipse;shape=startState;fillColor=#000000;strokeColor=#000000;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-out" value="Chưa đăng nhập&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;màn đăng nhập&lt;/span&gt;" style="rounded=1;arcSize=25;fillColor=#eff6ff;strokeColor=#334155;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="170" y="260" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-in" value="Đã đăng nhập&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;giữ Socket + token; tab theo vai&lt;/span&gt;" style="rounded=1;arcSize=25;fillColor=#eff6ff;strokeColor=#334155;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="720" y="260" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-lost" value="Mất kết nối&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;socket = null, vẫn giữ token&lt;/span&gt;" style="rounded=1;arcSize=25;fillColor=#eff6ff;strokeColor=#334155;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="720" y="530" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="st-end" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1240" y="300" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-1" value="mở ứng dụng" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-s" target="st-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-2" value="auth.login ok / lưu token" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-out" target="st-in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-3" value="Đăng xuất / close()" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-in" target="st-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-4" value="UNAUTHORIZED (bị khóa, hết hạn)&lt;br&gt;/ báo lỗi, close()" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-in" target="st-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-5" value="IOException / timeout 60 s&lt;br&gt;/ NETWORK_ERROR" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-in" target="st-lost">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-6" value="gọi action kế tiếp&lt;br&gt;/ connect lại, gửi kèm token" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-lost" target="st-in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-7" value="đóng cửa sổ / close()" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-in" target="st-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-8" value="đóng cửa sổ" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-out" target="st-end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="295" y="160" />
              <mxPoint x="1255" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-9" value="SocketClient.call có synchronized: các luồng SwingWorker dùng chung một kết nối, mỗi lần gửi một khung và chờ đúng phản hồi cùng id. Mất kết nối không bắt đăng nhập lại: lần gọi sau tự mở Socket mới và dùng lại token còn hạn." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffbeb;strokeColor=#b45309;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1220" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
