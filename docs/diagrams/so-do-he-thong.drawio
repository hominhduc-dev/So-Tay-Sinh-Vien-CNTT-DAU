        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Sơ đồ trạng thái — Một kết nối TCP phía server (ClientConnection)" style="text;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1240" height="34" as="geometry" />
