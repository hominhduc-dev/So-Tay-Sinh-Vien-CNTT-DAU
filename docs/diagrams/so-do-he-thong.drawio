        <mxCell id="relation-5" edge="1" parent="1" source="questions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;startFill=0;startSize=14;endArrow=none;endFill=0;endSize=18;strokeColor=#475569;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;labelBackgroundColor=#ffffff;" target="messages" value="Được chọn · question_id">
