        <mxCell id="flow-23" value="«TCP/IP» khung JSON&lt;br&gt;không import chéo" style="endArrow=none;html=1;strokeColor=#1d4ed8;strokeWidth=2;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-net" target="s-socket">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="655" />
              <mxPoint x="800" y="110" />
              <mxPoint x="1210" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-24" value="Mũi tên nét đứt «import»: package nguồn dùng lớp của package đích. Client và server là hai chương trình riêng, không import lẫn nhau; chỉ nói chuyện qua TCP. common.socket phụ thuộc account (UserRepository, Role) để kiểm token và vai ở mỗi yêu cầu. common.view dựng các màn hình của mọi module (MainFrame)." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffbeb;strokeColor=#b45309;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="790" width="1560" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
