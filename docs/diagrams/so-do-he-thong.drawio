              <mxPoint x="1000" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-6" value="im lặng 30 phút / SocketTimeoutException" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-idle" target="st-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-7" value="độ dài khung &gt; 32 MB&lt;br&gt;/ gửi FRAME_TOO_LARGE, đóng" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-idle" target="st-end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="253" />
              <mxPoint x="1000" y="225" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-8" value="lỗi I/O khi ghi / đóng socket" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-busy" target="st-end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1165" y="485" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note-9" value="Mỗi kết nối chạy trên một luồng socket-client-N (pool 64). Lỗi nghiệp vụ không đóng kết nối; chỉ EOF, quá thời gian chờ, khung quá lớn hoặc lỗi I/O mới chuyển sang trạng thái kết thúc và trả luồng về pool." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fffbeb;strokeColor=#b45309;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1">
