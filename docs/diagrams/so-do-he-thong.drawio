        <mxCell id="conversation-message" edge="1" parent="1" source="Conversation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Times New Roman;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.3;startArrow=diamond;startFill=1;endArrow=none;endFill=0;dashed=0;" target="Message" value="chứa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conversation-message-one" connectable="0" parent="conversation-message" style="edgeLabel;html=1;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;resizable=0;" value="1" vertex="1">
          <mxGeometry relative="1" x="-0.85" y="-18" as="geometry" />
        </mxCell>
        <mxCell id="conversation-message-many" connectable="0" parent="conversation-message" style="edgeLabel;html=1;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;resizable=0;" value="0..*" vertex="1">
          <mxGeometry relative="1" x="0.85" y="-18" as="geometry" />
        </mxCell>
        <mxCell id="question-message" edge="1" parent="1" source="Question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Times New Roman;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#475569;strokeWidth=1.3;startArrow=none;startFill=1;endArrow=none;endFill=0;dashed=0;" target="Message" value="được chọn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="question-message-one" connectable="0" parent="question-message" style="edgeLabel;html=1;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;resizable=0;" value="1" vertex="1">
          <mxGeometry relative="1" x="-0.85" y="-18" as="geometry" />
        </mxCell>
        <mxCell id="question-message-many" connectable="0" parent="question-message" style="edgeLabel;html=1;fontFamily=Times New Roman;fontSize=17;labelBackgroundColor=#ffffff;resizable=0;" value="0..*" vertex="1">
          <mxGeometry relative="1" x="0.85" y="-18" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;align=left;verticalAlign=top;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=17;" value="&lt;b&gt;Ký hiệu UML:&lt;/b&gt; − private; + public; ~ package-private; phương thức gạch chân = static.&lt;br&gt;Đường liền: association; hình thoi đặc ở Conversation: composition với Message (cascade + orphanRemoval).&lt;br&gt;Multiplicity: 1 ↔ 0..*. Các giá trị enum Role được ghi trực tiếp trong lớp User." vertex="1">
          <mxGeometry height="115" width="1920" x="70" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="scope" parent="1" style="text;align=left;verticalAlign=top;fontColor=#475569;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=17;" value="&lt;b&gt;Phạm vi:&lt;/b&gt; 6 entity Java; enum Role hiển thị trong User; thuộc tính dùng kiểu Java, không dùng kiểu SQL.&lt;br&gt;Chỉ liệt kê phương thức chính; getter/setter do Lombok sinh được chọn lọc. Constructor của Message có phạm vi package.&lt;br&gt;Topic.getQuestions() chỉ trả câu hỏi đang hiện. Upload / gỡ tài liệu thuộc DocumentService; không gán các phương thức đó cho entity Document.&lt;br&gt;Sinh viên, Giáo vụ, Quản trị viên được biểu diễn qua User.role; code hiện tại không có ba lớp con kế thừa User." vertex="1">
          <mxGeometry height="150" width="1920" x="70" y="1680" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
