        </mxCell>
        <mxCell id="st-wait" value="Chờ kết nối&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;ServerSocket.accept()&lt;/span&gt;" style="rounded=1;arcSize=25;fillColor=#eff6ff;strokeColor=#334155;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="170" y="160" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-idle" value="Chờ khung&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;readInt() — chặn tới khi có dữ liệu&lt;/span&gt;" style="rounded=1;arcSize=25;fillColor=#eff6ff;strokeColor=#334155;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-busy" value="Đang xử lý&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;SocketDispatcher.handle&lt;/span&gt;" style="rounded=1;arcSize=25;fillColor=#eff6ff;strokeColor=#334155;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-end" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1180" y="200" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flow-1" value="" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-s" target="st-wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-2" value="client connect / setTcpNoDelay,&lt;br&gt;setSoTimeout(30 phút), giao luồng pool" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-wait" target="st-idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-3" value="nhận đủ N byte [N ≤ 32 MB]" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-idle" target="st-busy">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flow-4" value="ghi khung phản hồi {id, ok, …}&lt;br&gt;(kể cả lỗi BAD_FRAME, UNKNOWN_ACTION)" style="rounded=1;html=1;endArrow=open;endSize=10;strokeColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Times New Roman;fontSize=14;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-busy" target="st-idle">
          <mxGeometry relative="1" as="geometry">
