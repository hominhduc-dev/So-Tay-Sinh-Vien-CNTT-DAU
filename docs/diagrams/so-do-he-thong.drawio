  <diagram id="sequence-UC01" name="SEQ UC01 · Đăng nhập">
    <mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
