        </mxCell>
        <mxCell id="title" value="UC01 — Đăng nhập" style="text;fontStyle=1;;html=1;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="25" y="15" width="1119" height="34" as="geometry" />
        </mxCell>
